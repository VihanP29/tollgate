# Local mode retains loopback operator access; hosted requires verified JWT identity.
TOLLGATE_MODE=local
DATABASE_URL=sqlite:///.runtime/platform.sqlite
TOLLGATE_PUBLIC_ORIGIN=http://127.0.0.1:8765
TOLLGATE_OPERATOR_TOKEN=
TOLLGATE_AUDITOR_TOKEN=

# Hosted JWT adapter: issuer, intended audience, and HTTPS JWKS URL. No local token fallback.
TOLLGATE_IDENTITY_ISSUER=
TOLLGATE_IDENTITY_AUDIENCE=
TOLLGATE_IDENTITY_JWKS_URL=

# Platform paid capabilities remain disabled until matching live admission is implemented.
TOLLGATE_LIVE_JEV_ENABLED=false
TOLLGATE_LIVE_AGENT_ENABLED=false
TOLLGATE_CLAIMS_MODE=off
TOLLGATE_VISION_ENABLED=false
TOLLGATE_WORKSPACE_CALLS=100
TOLLGATE_GLOBAL_CALLS=1000
TOLLGATE_WORKSPACE_TOKENS=500000
TOLLGATE_GLOBAL_TOKENS=2000000
# Evaluation/shadow usage may consume at most this fraction of each total allowance.
TOLLGATE_EVALUATION_USAGE_FRACTION=0.2
TOLLGATE_MAX_JOBS=20
TOLLGATE_GLOBAL_JOBS=100
TOLLGATE_MAX_PROPOSALS=500
TOLLGATE_MAX_RUNS=20
TOLLGATE_MAX_STEPS=45
TOLLGATE_PROVIDER_TIMEOUT_S=15
TOLLGATE_MAX_RETRIES=2
TOLLGATE_LEASE_SECONDS=120
TOLLGATE_MAX_REQUEST_BYTES=65536
TOLLGATE_WORKER_STALE_SECONDS=180

# Optional legacy local Control Room providers; new workspace execution stays offline.
TYPESAFE_API_KEY=
ANTHROPIC_API_KEY=
TOLLGATE_AGENT_MODEL=claude-opus-5-5
